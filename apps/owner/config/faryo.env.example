FARYO_OWNER_HOST=127.0.0.1
FARYO_OWNER_PORT=8765
FARYO_OWNER_TOKEN=replace-with-long-random-token
FARYO_OWNER_DIRECT_SESSION=__faryo_no_default__
FARYO_OWNER_TMUX_SESSION=local-tmux-owner
# Optional absolute interpreter path, for example a dedicated Conda env.
FARYO_PYTHON=python3
# Optional absolute Codex CLI path. Set this when the service PATH does not
# include a version-manager installation such as nvm.
# FARYO_CODEX_BIN=$HOME/.local/bin/codex
FARYO_OWNER_LABEL=LOCAL
FARYO_OWNER_DATA=$HOME/.faryo/owner/data
FARYO_OWNER_INBOX_DIR=$FARYO_OWNER_DATA/inbox
FARYO_OWNER_ARTIFACTS_DIR=$FARYO_OWNER_DATA/artifacts
FARYO_OWNER_CACHE_DIR=$FARYO_OWNER_DATA/cache
FARYO_OWNER_LOGS_DIR=$FARYO_OWNER_DATA/logs
# FARYO_OWNER_FILE_INBOX=$FARYO_OWNER_DATA/inbox
# Optional launcher override for Claude-compatible local wrappers.
# FARYO_CLAUDE_DEEPSEEK_LAUNCHER=$HOME/path/to/claude-compatible-launcher
TMUX_HISTORY_LIMIT=500
WEB_CAPTURE_LINES=800

# Project workbench upload/downlink. Prefer scripts/init-owner-env.sh so the
# sync URL is derived from one Gateway URL instead of hand-copying both fields.
FARYO_PROJECT_WORKBENCH_ENABLE=1
FARYO_PROJECT_WORKBENCH_GATEWAY_URL=https://your-gateway.example
FARYO_PROJECT_WORKBENCH_SYNC_URL=https://your-gateway.example/api/project-workbench/sync
FARYO_PROJECT_WORKBENCH_SYNC_OWNER_LABEL=$FARYO_OWNER_LABEL
# Pass explicit project roots to scripts/sync-project-workbench.sh, or fill this
# with colon-separated project directories that contain 00-system/workbench.json.
FARYO_PROJECT_WORKBENCH_ROOTS=
FARYO_PROJECT_WORKBENCH_PROJECTS_ROOT=$HOME/brain/projects
FARYO_PROJECT_WORKBENCH_ALLOWED_ROOTS=$HOME/brain/projects:$HOME/brain/tools:$HOME/.faryo/projects

# Optional reverse tunnel verification. Fill only in private env files for
# deployments that establish a reverse tunnel to the Gateway host.
# GATEWAY_TUNNEL_HOST=replace-with-gateway-host-or-ip
# GATEWAY_TUNNEL_USER=replace-with-ssh-user
# GATEWAY_TUNNEL_HOST_ALIAS=replace-with-known-host-alias
# GATEWAY_TUNNEL_KNOWN_HOSTS=$HOME/.ssh/known_hosts
# GATEWAY_TUNNEL_IDENTITY=$HOME/.ssh/id_ed25519
# GATEWAY_TUNNEL_REMOTE_PORT=replace-with-remote-loopback-port
# GATEWAY_TUNNEL_VERIFY_IN_STATUS=0
