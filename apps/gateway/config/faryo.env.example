FARYO_GATEWAY_USER=faryo
# Prefer a mode-600 password file so the plaintext password does not need to
# remain in this multi-purpose environment file.
FARYO_GATEWAY_PASSWORD_FILE=$HOME/.faryo/gateway/config/initial-password
# FARYO_GATEWAY_PASSWORD=replace-with-long-random-password
FARYO_PYTHON=python3

# Only routes listed in FARYO_GATEWAY_ROUTES need an Owner token. Do not add
# placeholder values for disabled routes.
FARYO_GATEWAY_ROUTES=txy
FARYO_TXY_OWNER_TOKEN=replace-with-txy-owner-token
# FARYO_HP_OWNER_TOKEN=replace-with-hp-owner-token
# FARYO_PC_OWNER_TOKEN=replace-with-pc-owner-token
# MCP is disabled when FARYO_MCP_TOKEN is unset. Enable it only when needed.
# FARYO_MCP_TOKEN=replace-with-independent-mcp-token
# FARYO_MCP_USER=faryo
# Optional browser origin allowed to call /mcp. Leave empty for non-browser MCP use.
# FARYO_MCP_CORS_ORIGIN=https://your-faryo.example

# Optional filing record shown in the sign-in and password page footer, linked to
# the official filing site. Required for mainland China hosting; leave unset
# elsewhere and the footer is omitted.
# FARYO_ICP_RECORD=your-filing-record

FARYO_DEFAULT_WORKSPACE=$HOME/.faryo/workspaces/default
FARYO_DEFAULT_FILE_INBOX=$HOME/.faryo/owner/data/inbox

# Route backend addresses. Defaults point remote endpoints at the Gateway
# loopback ports their reverse tunnels provide, and TXY at the Owner running on
# the Gateway host itself.
# FARYO_HP_OWNER_HOST=127.0.0.1
# FARYO_HP_OWNER_PORT=18766
# FARYO_HP_OWNER_LABEL=HP
# FARYO_TXY_OWNER_HOST=127.0.0.1
# FARYO_TXY_OWNER_PORT=8765
# FARYO_TXY_OWNER_LABEL=TXY
# FARYO_PC_OWNER_HOST=127.0.0.1
# FARYO_PC_OWNER_PORT=18765
# FARYO_PC_OWNER_LABEL=PC
