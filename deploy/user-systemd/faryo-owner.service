[Unit]
Description=Faryo Owner
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@FARYO_ROOT_PATH@
Environment="FARYO_HOME=@FARYO_HOME@"
Environment="FARYO_INSTALL_ROOT=@FARYO_ROOT@"
Environment="PYTHONPATH=@FARYO_ROOT@/src"
ExecStart="@FARYO_PYTHON@" -m faryo_cli internal run-owner
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
